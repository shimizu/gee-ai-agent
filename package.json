{
  "name": "gee-ai-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Google Earth Engine をブラウザ上の AI エージェントに操作させ、地図（deck.gl-raster）とチャートで分析結果を出力するブラウザ完結型アプリ",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@developmentseed/deck.gl-raster": "0.8.0-beta.2",
    "@developmentseed/morecantile": "0.8.0-beta.2",
    "@google/earthengine": "^1.7.30",
    "@luma.gl/core": "^9.3.0",
    "@luma.gl/shadertools": "^9.3.0",
    "deck.gl": "^9.3.4",
    "geotiff": "^3.0.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@eslint/js": "^10.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.0"
  }
}
